# ─── Brandflux Environment Configuration ────────────────────────────────────

# PostgreSQL
POSTGRES_USER=brandflux
POSTGRES_PASSWORD=brandflux_secret
POSTGRES_DB=brandflux
DATABASE_URL=postgresql://brandflux:brandflux_secret@postgres:5432/brandflux

# Redis & Rate Limiting
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_CONTENT_GEN=5/minute
RATE_LIMIT_SESSION_GEN=5/minute

# CORS (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2 / S3-Compatible CDN
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=brandflux-media
R2_PUBLIC_URL=https://pub-your_public_r2_hash.r2.dev

# Auth & AI Secrets
SECRET_KEY=brandflux-super-secret-key-12345
GEMINI_API_KEY=your_gemini_api_key_here
ENCRYPTION_KEY=

# Meta & LinkedIn Social Publishing
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/settings?tab=accounts
META_WEBHOOK_VERIFY_TOKEN=brandflux-webhook-verify-token
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/settings?tab=accounts
USE_SOCIAL_AGGREGATOR=false
AYRSHARE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

