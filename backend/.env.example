# ─── Database Settings (PostgreSQL with SQLAlchemy + Alembic) ──────────────
DATABASE_URL=postgresql://brandflux:brandflux_secret@localhost:5432/brandflux

# ─── Redis Cache & Rate Limiting (slowapi) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_CONTENT_GEN=5/minute
RATE_LIMIT_SESSION_GEN=5/minute

# ─── CORS Allowed Origins (Comma-separated) ─────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Cloudflare R2 / S3-Compatible Storage ──────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=brandflux-media
R2_PUBLIC_URL=https://pub-your_public_r2_hash.r2.dev
# Optional custom S3 endpoint override:
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ─── Auth Settings ──────────────────────────────────────────────────────────
SECRET_KEY=brandflux-super-secret-key-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7
ADMIN_EMAIL=admin@brandflux.ai
ADMIN_PASSWORD=Admin123!#Brandflux

# ─── Gemini AI & Image Generation ──────────────────────────────────────────
# Note: Google's Nano Banana 2.1 requires a paid Gemini API key with billing enabled
GEMINI_API_KEY=your_gemini_api_key_here
IMAGE_MODEL=gemini-nano-banana-2.1

# ─── Scraper & Scheduler Settings ───────────────────────────────────────────
SCRAPER_TIMEOUT=15.0
SCAN_STALE_MINUTES=30
DAILY_QUESTIONS_HOUR=6
WEEKLY_GUIDANCE_DAY=mon

# ─── Celery & Social Publishing ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ENCRYPTION_KEY=                        # Optional: Base64-encoded 32-byte Fernet key. If omitted, derived from SECRET_KEY.

# ─── Meta Graph API (Instagram & Facebook) ─────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/settings?tab=accounts
META_WEBHOOK_VERIFY_TOKEN=brandflux-meta-verify-token

# ─── LinkedIn API ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/settings?tab=accounts

# ─── Aggregator Switch (e.g. Ayrshare) ───────────────────────────────────────
USE_SOCIAL_AGGREGATOR=false
AYRSHARE_API_KEY=your_ayrshare_api_key
